flowchart TD
  classDef step fill:#eef2ff,stroke:#4f46e5,stroke-width:1.4px,color:#111827;
  classDef risk fill:#fef2f2,stroke:#ef4444,stroke-width:1.4px,color:#111827;
  classDef ok fill:#ecfdf5,stroke:#10b981,stroke-width:1.4px,color:#111827;

  U[Photo uploaded]:::step --> V1[Technical validation\nformat, size, mime]:::step
  V1 --> V2[Metadata extraction\nEXIF, timestamps, device, GPS]:::step
  V2 --> V3[Exact hash\nSHA-256]:::step
  V2 --> V4[Visual hash\nPerceptual hash]:::step
  V3 --> C1[Exact duplicate check]:::step
  V4 --> C2[Visual similarity check]:::step
  V2 --> C3[Time consistency check]:::step
  V2 --> C4[Geo-context check]:::step
  C1 --> RS[Risk scoring engine]:::risk
  C2 --> RS
  C3 --> RS
  C4 --> RS
  RS --> S1[Status: OK]:::ok
  RS --> S2[Status: Needs Review]:::risk
  RS --> S3[Status: Suspicious/High Risk]:::risk
  S1 --> M[Manager report view]
  S2 --> M
  S3 --> M
